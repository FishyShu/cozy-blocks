#!/bin/sh
# cozy next|mute|pet|<weather>  -  pokes the Cozy Blocks wallpaper (it watches this dir)
case "$1" in next|mute|pet|clear|rain|snow|leaves|petals) ;; *) echo "usage: cozy next|mute|pet|clear|rain|snow|leaves|petals" >&2; exit 1 ;; esac
d="${XDG_CACHE_HOME:-$HOME/.cache}/cozyblocks"
mkdir -p "$d"
find "$d" -type f -mmin +1 -delete
touch "$d/$1.$(date +%s%N)"
